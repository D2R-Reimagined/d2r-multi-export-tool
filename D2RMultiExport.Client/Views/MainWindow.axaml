<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:D2RMultiExport.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="780"
        x:Class="D2RMultiExport.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="D2RMultiExport - D2R Multi Export Tool"
        Width="900" Height="780"
        MinWidth="780" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Slightly muted but still readable hint colour. The previous
             #777777 hint text was unreadable on the default dark theme. -->
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.hint.invalid">
            <Setter Property="Foreground" Value="#FF8A80"/>
        </Style>
        <Style Selector="TextBlock.logline.warning">
            <Setter Property="Foreground" Value="#FFD54F"/>
        </Style>
        <Style Selector="TextBlock.logline.error">
            <Setter Property="Foreground" Value="#FF8A80"/>
        </Style>
        <Style Selector="Label.field">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Styles>

    <Grid Margin="15" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- ─── Path inputs ─────────────────────────────────────────── -->
        <Border Grid.Row="0" BorderBrush="#555" BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="220,*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <Label Grid.Row="0" Grid.Column="0" Classes="field" Content="Mod Data Directory"
                       ToolTip.Tip="The mod's data folder (contains global\excel, local\lng\strings and optionally hd). The mod repository root containing data is accepted too."/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ModDataBox" Text="{Binding ModDataPath}" Margin="0,3"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseModData_Click"
                        HorizontalAlignment="Stretch" Margin="6,3,0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModDataStatusText"
                           Classes="hint" Classes.invalid="{Binding !ModDataValid}"
                           Text="{Binding ModDataStatus}" Margin="0,0,0,6"/>

                <Label Grid.Row="2" Grid.Column="0" Classes="field" Content="CASC Data Directory"
                       ToolTip.Tip="The extracted vanilla D2R data folder (data or CascView's data\data). Supplies every file the mod does not ship: HD sprites, base strings, vanilla tables."/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CascDataBox" Text="{Binding CascDataPath}" Margin="0,3"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseCascData_Click"
                        HorizontalAlignment="Stretch" Margin="6,3,0,3"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CascDataStatusText"
                           Classes="hint" Classes.invalid="{Binding !CascDataValid}"
                           Text="{Binding CascDataStatus}" Margin="0,0,0,6"/>

                <Label Grid.Row="4" Grid.Column="0" Classes="field" Content="Output Files Directory"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="OutputBox" Text="{Binding OutputPath}" Margin="0,3"/>
                <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click"
                        HorizontalAlignment="Stretch" Margin="6,3,0,3"/>

                <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DestructiveExportBox"
                          IsChecked="{Binding DestructiveExport}"
                          Content="Destructive export — replace all existing destination contents"
                          ToolTip.Tip="After a run without errors, the Output Files Directory holds only this export: every other file in it is deleted. The export is generated in full first; a run with errors, or a replacement that fails, leaves the existing contents in place. Refused for drive roots, repository roots and similar locations."/>
                <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DestructiveStatusText"
                           Classes="hint" Classes.invalid="{Binding !DestructiveValid}"
                           Text="{Binding DestructiveStatus}"/>

                <Label Grid.Row="7" Grid.Column="0" Classes="field" Content="Dry-run Log Directory"
                       ToolTip.Tip="Dry Run performs the full export into a scratch folder and discards it; the Output Files Directory is never touched. Only dryrun-errors.txt is kept here, and only when the run recorded errors. Empty: test-output\dryrun of the repository containing the exporter."/>
                <TextBox Grid.Row="7" Grid.Column="1" x:Name="DryRunLogBox" Text="{Binding DryRunLogPath}"
                         PlaceholderText="{Binding DefaultDryRunLogPath}" Margin="0,6,0,0"/>
                <Button Grid.Row="7" Grid.Column="2" Content="Browse..." Click="BrowseDryRunLog_Click"
                        HorizontalAlignment="Stretch" Margin="6,6,0,0"/>
            </Grid>
        </Border>

        <!-- ─── Pipeline options ────────────────────────────────────── -->
        <Border Grid.Row="1" BorderBrush="#555" BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="6">
                <TextBlock Text="Pipeline options" FontWeight="Bold"/>
                <TextBlock Classes="hint"
                           Text="Output is always the key-based bundle (keyed/*.json + strings/{lang}.json × 13) consumed by d2r-reimagined-website."/>
                <CheckBox IsChecked="{Binding ContinueOnException}"
                          Content="Continue on exception (record per-phase failures into the import-report instead of aborting)"/>
                <CheckBox IsChecked="{Binding PrettyPrintJson}"
                          Content="Pretty-print JSON"
                          ToolTip.Tip="Indents all JSON exports."/>
                <CheckBox IsChecked="{Binding EarlyStopSentinelEnabled}"
                          Content="Cube: stop at grabber sentinel"
                          ToolTip.Tip="Stop cube recipe import at the last useful recipe."/>
                <CheckBox IsChecked="{Binding CubeRecipeUseDescription}"
                          Content="Cube: include cubemain.txt description"
                          ToolTip.Tip="Include the raw cubemain.txt description column in cube-recipe export."/>
            </StackPanel>
        </Border>

        <!-- ─── Run button + progress bar ───────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,8">
            <Button Grid.Column="0" x:Name="RunButton" Content="Import and Export"
                    Command="{Binding RunPipelineCommand}"
                    Padding="20,6" FontWeight="Bold"/>
            <Button Grid.Column="1" x:Name="DryRunButton" Content="Dry Run"
                    Command="{Binding DryRunPipelineCommand}"
                    Padding="20,6" Margin="8,0,0,0"
                    ToolTip.Tip="Run the full export and discard the output; only an error log is kept in the Dry-run Log Directory."/>
            <!-- Real percentage progress bar driven by PipelineProgress milestones.
                 ShowProgressText overlays the live "NN%" label so the user gets
                 numeric feedback in addition to the bar fill. The bound
                 ProgressTextFormat is updated by a 500ms DispatcherTimer in
                 the view-model while IsBusy, cycling a trailing "." / ".." /
                 "..." suffix so the overlay visibly animates between
                 milestone phases. -->
            <ProgressBar Grid.Column="2"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue}"
                         ShowProgressText="True"
                         ProgressTextFormat="{Binding ProgressTextFormat}"
                         Width="220" Height="18" Margin="12,0"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsBusy}"/>
        </Grid>

        <!-- ─── Live log panel ──────────────────────────────────────── -->
        <!-- Clicking anywhere in the log opens the expanded, non-modal viewer. -->
        <Border Grid.Row="3" x:Name="LogPanel" BorderBrush="#555" BorderThickness="1" CornerRadius="4"
                Padding="6" Margin="0,0,0,8" Cursor="Hand"
                ToolTip.Tip="Click to open the full log (search, filter, copy, save).">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="4,2,0,4">
                    <TextBlock Grid.Column="0" Text="Pipeline log" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="LogSummaryText" Classes="hint" Text="{Binding LogSummary}"
                               Margin="10,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="OpenLogButton" Content="Open full log" Click="OpenLog_Click" Padding="8,2"/>
                </Grid>
                <ListBox Grid.Row="1"
                         x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         FontFamily="Consolas, Menlo, Monospace"
                         FontSize="12"
                         Background="#111"
                         Foreground="#DDD"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                            <TextBlock Classes="logline" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}"
                                       Text="{Binding Text}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ─── Status line (always visible) ────────────────────────── -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}"
                   Foreground="#E0E0E0"
                   TextWrapping="Wrap"
                   Margin="2,0,2,4"/>
    </Grid>
</Window>
