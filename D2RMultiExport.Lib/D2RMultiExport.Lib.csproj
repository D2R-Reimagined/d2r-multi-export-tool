<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>D2RMultiExport.Lib</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2RMultiExport.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="D2RReimaginedTools.FileExtensions" Version="0.6.2" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\stat-overrides.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\export-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\synthetic-strings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\class-ranges.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\skill-desc-functions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Bundled CASC-derived reference tables: the canonical runes.txt used by
      the runeword importer to flag vanilla runewords, and the skillcalc.txt /
      misscalc.txt calc vocabularies used when neither the mod nor the CASC
      extraction supplies a copy.
      Users who hit missing-translation reports should supply a CascView
      extraction of the base game's data tree via the casc-data option;
      the bundled tree intentionally no longer ships Blizzard string tables.
    -->
    <None Update="Config\CASC_DATA\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
